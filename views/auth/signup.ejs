<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <% if(errorMessage) { %>
            <div class="user-message user-message--error"><%= errorMessage %></div>
        <% } %>
        <form class="login-form" action="/signup" method="POST" novalidate>
            <div class="form-control">
                <label for="name">Name</label>
                <input 
                    class="<%= errorValidation.find(err => err.path == 'name') ? 'invalid': '' %>"
                    type="text" 
                    name="name" 
                    id="name" 
                    value="<%= oldInput.name %>"
                >
            </div>
            <div class="form-control">
                <label for="email">E-Mail</label>
                <input
                    class="<%= errorValidation.find(err => err.path == 'email') ? 'invalid': '' %>" 
                    type="email" 
                    name="email" 
                    id="email" 
                    value="<%= oldInput.email %>"
                >
            </div>
            <div class="form-control">
                <label for="password">Password</label>
                <input 
                    class="<%= errorValidation.find(err => err.path == 'password') ? 'invalid': '' %>"
                    type="password" 
                    name="password" 
                    id="password" 
                    value="<%= oldInput.password %>"
                >
            </div>
            <div class="form-control">
                <label for="confirmPassword">Confirm Password</label>
                <input 
                    class="<%= errorValidation.find(err => err.path == 'confirmPassword') ? 'invalid': '' %>"
                    type="password" 
                    name="confirmPassword" 
                    id="confirmPassword" 
                    value="<%= oldInput.confirmPassword %>"
                >
            </div>
            <input hidden value="<%= csrfToken %>" name="_csrf">
            <button class="btn" type="submit">Sign up</button>
        </form>
    </main>
<%- include('../includes/end.ejs') %>